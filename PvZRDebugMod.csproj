<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ImGui.NET" Version="1.91.6.1" />
    <PackageReference Include="OpenTK.Graphics" Version="4.9.4" />
    <PackageReference Include="OpenTK.Windowing.Desktop" Version="4.9.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="KrutolFramework">
      <HintPath>..\KrutolFramework\bin\Debug\net10.0\KrutolFramework.dll</HintPath>
    </Reference>
    <Reference Include="PVZRemake">
      <HintPath>..\PVZRemake\bin\Release\net10.0-windows7.0\PVZRemake.dll</HintPath>
    </Reference>
  </ItemGroup>

</Project>
